@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cp:   <https://care-protocol.example/ontology#> .

# =====================================================================================
# Care Protocol Ontology (TBox) for the Context & Ontology benchmark (ADR-0010).
# Import into Ontobricks; map data in via care_protocol.r2rml.ttl. License-clean (LOINC
# multiaxial Parts + ICD-10 is-a + RxNorm + care-protocol edges; NO SNOMED relationships).
# The graph's value is the CROSS-vocabulary + protocol edges that a single closure cannot express.
#
# 2026-10-30 revision (see src/ontology/README.md "revision notes"):
#   + added LOINC axis properties hasSystem / hasMethod  (were implied by loinc_parts.predicate
#     = has_component/has_system/has_method, but only hasComponent existed → axis edges failed)
#   + property names here are the CANONICAL camelCase; the r2rml maps the snake_case
#     loinc_parts.predicate / protocol_edges.predicate values onto these explicitly.
#   + measure result status uses cp:status (MET/NOT_MET) — r2rml previously referenced a
#     non-existent cp:measureStatus.
#   ValueSet / ProtocolRule are RESERVED (no ABox instances in the demo yet) — kept for the
#     docs/graph but intentionally unmapped; wire them when value-set / rule data is generated.
# =====================================================================================

<https://care-protocol.example/ontology> a owl:Ontology ;
    rdfs:label "Care Protocol Ontology" ;
    rdfs:comment "HEDIS diabetes measures + clinical terminology + care-protocol knowledge. Synthetic/demo." .

# ---- Classes ----
cp:Patient        a owl:Class .
cp:Condition      a owl:Class .          # an ICD-10-CM diagnosis concept
cp:DiabetesDiagnosis a owl:Class ; rdfs:subClassOf cp:Condition .
cp:ChronicKidneyDisease a owl:Class ; rdfs:subClassOf cp:Condition .
cp:HeartFailure   a owl:Class ; rdfs:subClassOf cp:Condition .
cp:Pregnancy      a owl:Class ; rdfs:subClassOf cp:Condition .
cp:HepaticDisease a owl:Class ; rdfs:subClassOf cp:Condition .

cp:LabTest        a owl:Class .          # a LOINC term
cp:LoincPart      a owl:Class .          # a LOINC Part (Component/System/Method axis value)
cp:Observation    a owl:Class .          # a patient's lab result

cp:Medication     a owl:Class .          # an RxNorm clinical drug
cp:Ingredient     a owl:Class .          # an RxNorm ingredient
cp:DrugClass      a owl:Class .          # e.g. Statin, ACE inhibitor

cp:Measure        a owl:Class .          # a HEDIS measure (GSD/KED/BPD/SPD/EED)
# NOTE: ValueSet / ProtocolRule were declared but have NO R2RML mapping (no ABox). Ontobricks
# auto-binds every declared class to a catalog table, so these empty classes got bound to leftover
# tables — the *_compliance_metrics METRIC VIEWS — which cannot be probed with a plain SELECT
# (METRIC_VIEW_MISSING_MEASURE_FUNCTION) and aborted the entity scan. Removed until they have an
# ABox. Re-add together with a matching R2RML entity map (over a real table) if/when needed.

# ---- Object properties (the typed edges a closure table cannot all express) ----
cp:hasDiagnosis       a owl:ObjectProperty ; rdfs:domain cp:Patient ;    rdfs:range cp:Condition .
cp:hasObservation     a owl:ObjectProperty ; rdfs:domain cp:Patient ;    rdfs:range cp:Observation .
cp:ofTest             a owl:ObjectProperty ; rdfs:domain cp:Observation ; rdfs:range cp:LabTest .
cp:prescribed         a owl:ObjectProperty ; rdfs:domain cp:Patient ;    rdfs:range cp:Medication .

# LOINC multiaxial Parts — one typed property per axis (loinc_parts.predicate drives which):
cp:hasComponent       a owl:ObjectProperty ; rdfs:domain cp:LabTest ;    rdfs:range cp:LoincPart .   # "what is measured" (analyte)
cp:hasSystem          a owl:ObjectProperty ; rdfs:domain cp:LabTest ;    rdfs:range cp:LoincPart .   # "specimen/system" (e.g. Blood, Urine)
cp:hasMethod          a owl:ObjectProperty ; rdfs:domain cp:LabTest ;    rdfs:range cp:LoincPart .   # "how it was measured"

cp:hasIngredient      a owl:ObjectProperty ; rdfs:domain cp:Medication ; rdfs:range cp:Ingredient .
cp:inDrugClass        a owl:ObjectProperty ; rdfs:domain cp:Ingredient ; rdfs:range cp:DrugClass .
cp:eligibleFor        a owl:ObjectProperty ; rdfs:domain cp:Patient ;    rdfs:range cp:Measure .
cp:hasCareGap         a owl:ObjectProperty ; rdfs:domain cp:Patient ;    rdfs:range cp:Measure .
# care-protocol knowledge edges (from the PDF) — the cross-domain, multi-hop relationships:
cp:recommendedFor     a owl:ObjectProperty ; rdfs:domain cp:DrugClass ; rdfs:range cp:Condition .
cp:contraindicatedWith a owl:ObjectProperty ; rdfs:domain cp:DrugClass ; rdfs:range cp:Condition .
cp:monitoredBy        a owl:ObjectProperty ; rdfs:domain cp:Measure ;   rdfs:range cp:LoincPart .

# `inDrugClass` is transitive-friendly: Medication -hasIngredient-> Ingredient -inDrugClass-> DrugClass.
# This 2-hop typed path is what the SQL rxnorm_closure flattens; the graph keeps it explicit + reasonable.

# ---- Data properties ----
cp:icd10Code        a owl:DatatypeProperty ; rdfs:domain cp:Condition ;   rdfs:range xsd:string .
cp:loincCode        a owl:DatatypeProperty ; rdfs:domain cp:LabTest ;     rdfs:range xsd:string .
cp:rxnormCode       a owl:DatatypeProperty ; rdfs:domain cp:Medication ;  rdfs:range xsd:string .
cp:resultValue      a owl:DatatypeProperty ; rdfs:domain cp:Observation ; rdfs:range xsd:double .
cp:status           a owl:DatatypeProperty ; rdfs:range xsd:string .   # MET / NOT_MET (measure result)
cp:ageAtPeriodEnd   a owl:DatatypeProperty ; rdfs:domain cp:Patient ;     rdfs:range xsd:integer .
cp:measurementYear  a owl:DatatypeProperty ; rdfs:range xsd:integer .

# ICD-10 is-a lives on rdfs:subClassOf among Condition concepts (mapped from icd10_hier).
# NOTE: the closure (icd10_closure) is the SQL materialization of subClassOf*; here a reasoner derives it.
# Edge qualifiers (protocol_edges.value, e.g. a monitoring threshold) are NOT modeled: they need edge
# reification, which R2RML can't emit cleanly. They stay in the relational/closure layer for now.
