@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix cp:   <https://care-protocol.example/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# =====================================================================================
# R2RML mappings: Unity Catalog tables -> Care Protocol Ontology (care_protocol.owl.ttl). This file IS the HEDIS graph:
# Eli imports it into the Ontobricks project `clinicaldomain` (replacing the project mapping) and publishes.
#
# rev 9 (2026-11-24): rewritten so it imports cleanly, the life-sciences pattern (clinical_study.r2rml.ttl):
#   * IRIs are https://care-protocol.example/ontology/<Class>/{id}, the form Ontobricks publishes. A relationship
#     endpoint resolves to an entity only when its IRI segment is the class name, so the old segments (icd/, obs/,
#     loinc/, part/, rx/, ing/) are now Condition/, Observation/, LabTest/, LoincPart/, Medication/, Ingredient/.
#     Before, unresolved edges kept the old segment while the entity's own facts sat on the class-named IRI, so
#     the graph was split (e.g. resultValue on Observation/..., hasObservation pointing at obs/...).
#   * one id column per class (patient_id, icd_code, loinc_code, part_code, rx_code, ing_code, drug_class, vs_id,
#     thr, measure_id, obs_id; the Condition subclasses dm_code, ckd_code, hf_code, preg_code, hep_code), reused
#     verbatim at every relationship endpoint; a same-class edge's target is icd_parent;
#   * every column a map uses is named in its SELECT (Ontobricks reads the SQL text and doesn't expand *);
#   * one map per (source class, property, target class): Ontobricks keeps one relationship per signature, so the
#     earlier five per-measure maps collapsed into one that read GSD only;
#   * ICD-10 is-a uses cp:subClassOf (rdfs:subClassOf is not an ontology property, so Ontobricks warns on it);
#   * the Condition subclasses are entities over icd10_closure, so nothing in the OWL is left for Ontobricks to
#     auto-bind (v5 bound Pregnancy to encounter rows);
#   * LabTest covers every LOINC code an observation uses (309), named from the curated loinc subset where it has the
#     code and from the observation's description otherwise (v6 typed only the 11 curated codes; v3 had 308).
# Source scope: care_protocol + care_protocol_terminology. NOT care_protocol_semantic (metric views abort the scan).
# Check before every import: .venv/bin/python -I scripts/ontobricks_dry_run.py --owl src/ontology/care_protocol.owl.ttl
#   --r2rml src/ontology/care_protocol.r2rml.ttl   (Ontobricks' own parse + diagnostics, plus row counts on ECT)
# =====================================================================================
# ---- Entities: one per class, each with its own id column ----
<#PatientEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT p.patient_id, p.patient_id AS patient_label, r.age FROM eli_test_classic_catalog.care_protocol.bronze_patient p LEFT JOIN eli_test_classic_catalog.care_protocol.panel_roster r ON r.patient_id = p.patient_id" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Patient/{patient_id}" ; rr:class cp:Patient ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "patient_label" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:ageAtPeriodEnd ; rr:objectMap [ rr:column "age" ] ] .

<#ConditionEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT code AS icd_code, MAX(name) AS icd_name FROM eli_test_classic_catalog.care_protocol_terminology.icd10_hier WHERE code IS NOT NULL GROUP BY code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Condition/{icd_code}" ; rr:class cp:Condition ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "icd_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:icd10Code ; rr:objectMap [ rr:column "icd_code" ] ] .

<#DiabetesDiagnosisEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT descendant_code AS dm_code, MAX(descendant_name) AS dm_code_name FROM eli_test_classic_catalog.care_protocol_terminology.icd10_closure WHERE ancestor_code IN ('E10','E11','E13') GROUP BY descendant_code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/DiabetesDiagnosis/{dm_code}" ; rr:class cp:DiabetesDiagnosis ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "dm_code_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:icd10Code ; rr:objectMap [ rr:column "dm_code" ] ] .

<#ChronicKidneyDiseaseEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT descendant_code AS ckd_code, MAX(descendant_name) AS ckd_code_name FROM eli_test_classic_catalog.care_protocol_terminology.icd10_closure WHERE ancestor_code = 'N18' GROUP BY descendant_code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/ChronicKidneyDisease/{ckd_code}" ; rr:class cp:ChronicKidneyDisease ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "ckd_code_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:icd10Code ; rr:objectMap [ rr:column "ckd_code" ] ] .

<#HeartFailureEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT descendant_code AS hf_code, MAX(descendant_name) AS hf_code_name FROM eli_test_classic_catalog.care_protocol_terminology.icd10_closure WHERE ancestor_code = 'I50' GROUP BY descendant_code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/HeartFailure/{hf_code}" ; rr:class cp:HeartFailure ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "hf_code_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:icd10Code ; rr:objectMap [ rr:column "hf_code" ] ] .

<#PregnancyEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT descendant_code AS preg_code, MAX(descendant_name) AS preg_code_name FROM eli_test_classic_catalog.care_protocol_terminology.icd10_closure WHERE ancestor_code IN ('Z34','O26','O15','O00') GROUP BY descendant_code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Pregnancy/{preg_code}" ; rr:class cp:Pregnancy ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "preg_code_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:icd10Code ; rr:objectMap [ rr:column "preg_code" ] ] .

<#HepaticDiseaseEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT descendant_code AS hep_code, MAX(descendant_name) AS hep_code_name FROM eli_test_classic_catalog.care_protocol_terminology.icd10_closure WHERE ancestor_code IN ('K70','K74') GROUP BY descendant_code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/HepaticDisease/{hep_code}" ; rr:class cp:HepaticDisease ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "hep_code_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:icd10Code ; rr:objectMap [ rr:column "hep_code" ] ] .

<#LabTestEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT c.loinc_code, COALESCE(MAX(l.long_common_name), MAX(c.description)) AS loinc_name FROM (SELECT loinc_code, CAST(NULL AS STRING) AS description FROM eli_test_classic_catalog.care_protocol_terminology.loinc UNION ALL SELECT loinc_code, description FROM eli_test_classic_catalog.care_protocol.silver_observation) c LEFT JOIN eli_test_classic_catalog.care_protocol_terminology.loinc l ON l.loinc_code = c.loinc_code WHERE c.loinc_code IS NOT NULL GROUP BY c.loinc_code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/LabTest/{loinc_code}" ; rr:class cp:LabTest ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "loinc_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:loincCode ; rr:objectMap [ rr:column "loinc_code" ] ] .

<#LoincPartEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT part AS part_code, MAX(part_name) AS part_name FROM eli_test_classic_catalog.care_protocol_terminology.loinc_parts WHERE part IS NOT NULL GROUP BY part" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/LoincPart/{part_code}" ; rr:class cp:LoincPart ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "part_name" ] ] .

<#MedicationEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT rx_code, MAX(rx_name) AS rx_name FROM (SELECT code AS rx_code, name AS rx_name FROM eli_test_classic_catalog.care_protocol_terminology.rxnorm_hier WHERE relationship = 'ingredient_of' UNION ALL SELECT rxnorm_code AS rx_code, description AS rx_name FROM eli_test_classic_catalog.care_protocol.bronze_order_med WHERE rxnorm_code IS NOT NULL) m GROUP BY rx_code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Medication/{rx_code}" ; rr:class cp:Medication ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "rx_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:rxnormCode ; rr:objectMap [ rr:column "rx_code" ] ] .

<#IngredientEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT code AS ing_code, MAX(name) AS ing_name FROM eli_test_classic_catalog.care_protocol_terminology.rxnorm_hier WHERE relationship = 'class_member' GROUP BY code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Ingredient/{ing_code}" ; rr:class cp:Ingredient ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "ing_name" ] ] .

<#DrugClassEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT code AS drug_class, MAX(name) AS drug_class_name FROM eli_test_classic_catalog.care_protocol_terminology.rxnorm_hier WHERE code LIKE 'DRUGCLASS-%' GROUP BY code" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/DrugClass/{drug_class}" ; rr:class cp:DrugClass ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "drug_class_name" ] ] .

<#ValueSetEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT v.vs_id, COALESCE(MAX(s.segment_name), v.vs_id) AS vs_name FROM (SELECT segment_id AS vs_id FROM eli_test_classic_catalog.care_protocol_terminology.value_set_segment UNION SELECT object AS vs_id FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate IN ('recommendedFor','contraindicatedWith','firstLineFor') UNION SELECT subject AS vs_id FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'definedBy') v LEFT JOIN eli_test_classic_catalog.care_protocol_terminology.value_set_segment s ON s.segment_id = v.vs_id WHERE v.vs_id <> 'SPD' GROUP BY v.vs_id" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/ValueSet/{vs_id}" ; rr:class cp:ValueSet ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "vs_name" ] ] ;
  rr:predicateObjectMap [ rr:predicate cp:valueSetId ; rr:objectMap [ rr:column "vs_id" ] ] .

<#ThresholdEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT object AS thr, MAX(value) AS thr_value FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate IN ('contraindicatedWhen','definedBy','hasThreshold') GROUP BY object" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Threshold/{thr}" ; rr:class cp:Threshold ] ;
  rr:predicateObjectMap [ rr:predicate cp:thresholdValue ; rr:objectMap [ rr:column "thr_value" ] ] .

<#MeasureEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT 'GSD' AS measure_id UNION SELECT 'BPD' UNION SELECT 'KED' UNION SELECT 'EED' UNION SELECT 'SPD' UNION SELECT 'MAD'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Measure/{measure_id}" ; rr:class cp:Measure ] .

<#ObservationEntity> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT CONCAT_WS('_', patient_id, loinc_code, CAST(result_ts AS STRING)) AS obs_id, value_num FROM eli_test_classic_catalog.care_protocol.silver_observation WHERE loinc_code IS NOT NULL" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Observation/{obs_id}" ; rr:class cp:Observation ] ;
  rr:predicateObjectMap [ rr:predicate cp:resultValue ; rr:objectMap [ rr:column "value_num" ] ] .

# ---- Patient records ----
<#HasDiagnosisMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT DISTINCT patient_id, icd10_code AS icd_code FROM eli_test_classic_catalog.care_protocol.silver_condition WHERE icd10_code IS NOT NULL" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Patient/{patient_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasDiagnosis ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Condition/{icd_code}" ] ] .

<#HasObservationMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT patient_id, CONCAT_WS('_', patient_id, loinc_code, CAST(result_ts AS STRING)) AS obs_id FROM eli_test_classic_catalog.care_protocol.silver_observation WHERE loinc_code IS NOT NULL" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Patient/{patient_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasObservation ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Observation/{obs_id}" ] ] .

<#OfTestMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT CONCAT_WS('_', patient_id, loinc_code, CAST(result_ts AS STRING)) AS obs_id, loinc_code FROM eli_test_classic_catalog.care_protocol.silver_observation WHERE loinc_code IS NOT NULL" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Observation/{obs_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:ofTest ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/LabTest/{loinc_code}" ] ] .

<#PrescribedMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT DISTINCT patient_id, rxnorm_code AS rx_code FROM eli_test_classic_catalog.care_protocol.bronze_order_med WHERE rxnorm_code IS NOT NULL" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Patient/{patient_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:prescribed ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Medication/{rx_code}" ] ] .

# ---- Terminology ----
<#ConditionSubClassOfMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT code AS icd_code, parent_code AS icd_parent FROM eli_test_classic_catalog.care_protocol_terminology.icd10_hier WHERE parent_code IS NOT NULL" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Condition/{icd_code}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:subClassOf ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Condition/{icd_parent}" ] ] .

<#HasComponentMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT loinc_code, part AS part_code FROM eli_test_classic_catalog.care_protocol_terminology.loinc_parts WHERE predicate = 'has_component'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/LabTest/{loinc_code}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasComponent ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/LoincPart/{part_code}" ] ] .

<#HasSystemMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT loinc_code, part AS part_code FROM eli_test_classic_catalog.care_protocol_terminology.loinc_parts WHERE predicate = 'has_system'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/LabTest/{loinc_code}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasSystem ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/LoincPart/{part_code}" ] ] .

<#HasMethodMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT loinc_code, part AS part_code FROM eli_test_classic_catalog.care_protocol_terminology.loinc_parts WHERE predicate = 'has_method'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/LabTest/{loinc_code}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasMethod ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/LoincPart/{part_code}" ] ] .

<#HasIngredientMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT code AS rx_code, parent_code AS ing_code FROM eli_test_classic_catalog.care_protocol_terminology.rxnorm_hier WHERE relationship = 'ingredient_of'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Medication/{rx_code}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasIngredient ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Ingredient/{ing_code}" ] ] .

<#InDrugClassMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT code AS ing_code, parent_code AS drug_class FROM eli_test_classic_catalog.care_protocol_terminology.rxnorm_hier WHERE relationship = 'class_member'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Ingredient/{ing_code}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:inDrugClass ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/DrugClass/{drug_class}" ] ] .

<#ValueSetContainsMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT DISTINCT v.segment_id AS vs_id, v.code AS icd_code FROM eli_test_classic_catalog.care_protocol_terminology.value_set_segment v JOIN eli_test_classic_catalog.care_protocol_terminology.icd10_hier h ON v.code = h.code WHERE v.code_system = 'ICD10CM'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/ValueSet/{vs_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:contains ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Condition/{icd_code}" ] ] .

# ---- Care-protocol knowledge (protocol_edges) ----
<#RecommendedForValueSetMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS drug_class, object AS vs_id FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'recommendedFor' AND object <> 'SPD'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/DrugClass/{drug_class}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:recommendedFor ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/ValueSet/{vs_id}" ] ] .

<#RecommendedForMeasureMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS drug_class, object AS measure_id FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'recommendedFor' AND object = 'SPD'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/DrugClass/{drug_class}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:recommendedFor ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Measure/{measure_id}" ] ] .

<#ContraindicatedWithMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS drug_class, object AS vs_id FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'contraindicatedWith'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/DrugClass/{drug_class}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:contraindicatedWith ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/ValueSet/{vs_id}" ] ] .

<#FirstLineForMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS drug_class, object AS vs_id FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'firstLineFor'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/DrugClass/{drug_class}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:firstLineFor ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/ValueSet/{vs_id}" ] ] .

<#ContraindicatedWhenMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS drug_class, object AS thr FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'contraindicatedWhen'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/DrugClass/{drug_class}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:contraindicatedWhen ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Threshold/{thr}" ] ] .

<#DefinedByMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS vs_id, object AS thr FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'definedBy'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/ValueSet/{vs_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:definedBy ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Threshold/{thr}" ] ] .

<#HasThresholdMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS measure_id, object AS thr FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'hasThreshold'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Measure/{measure_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasThreshold ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Threshold/{thr}" ] ] .

<#AppliesToMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS thr, object AS part_code FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'appliesTo'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Threshold/{thr}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:appliesTo ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/LoincPart/{part_code}" ] ] .

<#MonitoredByMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT subject AS measure_id, object AS part_code FROM eli_test_classic_catalog.care_protocol_terminology.protocol_edges WHERE predicate = 'monitoredBy'" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Measure/{measure_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:monitoredBy ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/LoincPart/{part_code}" ] ] .

# ---- Measure results (one map per relationship; each NOT (...) mirrors the governed view's Compliance Status) ----
<#EligibleForMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT patient_id, 'GSD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_gsd UNION ALL SELECT patient_id, 'BPD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_bpd UNION ALL SELECT patient_id, 'KED' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_ked UNION ALL SELECT patient_id, 'EED' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_eed UNION ALL SELECT patient_id, 'SPD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_spd UNION ALL SELECT patient_id, 'MAD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_mad" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Patient/{patient_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:eligibleFor ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Measure/{measure_id}" ] ] .

<#HasCareGapMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT patient_id, 'GSD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_gsd WHERE NOT (COALESCE(evidence_value <= 9.0, false)) UNION ALL SELECT patient_id, 'BPD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_bpd WHERE NOT (COALESCE(systolic < 140 AND diastolic < 90, false)) UNION ALL SELECT patient_id, 'KED' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_ked WHERE NOT (egfr_datetime IS NOT NULL AND uacr_datetime IS NOT NULL) UNION ALL SELECT patient_id, 'EED' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_eed WHERE NOT (evidence_datetime IS NOT NULL) UNION ALL SELECT patient_id, 'SPD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_spd WHERE NOT (evidence_datetime IS NOT NULL) UNION ALL SELECT patient_id, 'MAD' AS measure_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_mad WHERE NOT (COALESCE(pdc >= 0.8, false))" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/ontology/Patient/{patient_id}" ] ;
  rr:predicateObjectMap [ rr:predicate cp:hasCareGap ;
     rr:objectMap [ rr:template "https://care-protocol.example/ontology/Measure/{measure_id}" ] ] .
