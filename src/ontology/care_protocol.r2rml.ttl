<#EedCareGapMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT patient_id FROM eli_test_classic_catalog.care_protocol.gold_adherence_eed WHERE NOT (evidence_datetime IS NOT NULL)" ] ;
  rr:subjectMap [ rr:template "https://care-protocol.example/patient/{patient_id}" ] ;
