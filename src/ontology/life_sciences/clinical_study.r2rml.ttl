    rr:logicalTable [ rr:sqlQuery "SELECT participant_id, protocol_deviation_id FROM (SELECT concat(p.USUBJID, '.dev', CAST(x.pos AS STRING)) AS protocol_deviation_id, p.USUBJID AS participant_id, p.eligibility_rule_id AS rule_id, x.d.deviation AS deviation_type, x.d.severity AS severity, x.d.evidence AS evidence FROM eli_test_classic_catalog.clinical_study.gold_participant_population p LATERAL VIEW posexplode(p.deviations) x AS pos, d)" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/Participant/{participant_id}" ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/hasDeviation> ;
        rr:objectMap [ rr:template "https://clinical-study-lab.example/ontology/ProtocolDeviation/{protocol_deviation_id}" ] ] .
map:violates_criterion__protocol_deviation__eligibility_criterion a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT protocol_deviation_id, concat(rule_id, '.', c) AS eligibility_criterion_id FROM (SELECT concat(p.USUBJID, '.dev', CAST(x.pos AS STRING)) AS protocol_deviation_id, p.USUBJID AS participant_id, p.eligibility_rule_id AS rule_id, x.d.deviation AS deviation_type, x.d.severity AS severity, x.d.evidence AS evidence FROM eli_test_classic_catalog.clinical_study.gold_participant_population p LATERAL VIEW posexplode(p.deviations) x AS pos, d) LATERAL VIEW explode(split(evidence, ',')) e AS c WHERE deviation_type = 'ELIGIBILITY_VIOLATION'" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/ProtocolDeviation/{protocol_deviation_id}" ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/violatesCriterion> ;
        rr:objectMap [ rr:template "https://clinical-study-lab.example/ontology/EligibilityCriterion/{eligibility_criterion_id}" ] ] .
map:evidenced_by__protocol_deviation__con_med_record a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT protocol_deviation_id, evidence AS con_med_record_id FROM (SELECT concat(p.USUBJID, '.dev', CAST(x.pos AS STRING)) AS protocol_deviation_id, p.USUBJID AS participant_id, p.eligibility_rule_id AS rule_id, x.d.deviation AS deviation_type, x.d.severity AS severity, x.d.evidence AS evidence FROM eli_test_classic_catalog.clinical_study.gold_participant_population p LATERAL VIEW posexplode(p.deviations) x AS pos, d) WHERE evidence LIKE 'EDC-CM-%'" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/ProtocolDeviation/{protocol_deviation_id}" ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/evidencedBy> ;
        rr:objectMap [ rr:template "https://clinical-study-lab.example/ontology/ConMedRecord/{con_med_record_id}" ] ] .
map:fails_criterion__participant__eligibility_criterion a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT USUBJID AS participant_id, concat(eligibility_rule_id, '.', criterion_id) AS eligibility_criterion_id FROM eli_test_classic_catalog.clinical_study.gold_eligibility_criterion WHERE outcome IN ('TRIGGERED', 'NOT_MET')" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/Participant/{participant_id}" ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/failsCriterion> ;
        rr:objectMap [ rr:template "https://clinical-study-lab.example/ontology/EligibilityCriterion/{eligibility_criterion_id}" ] ] .
