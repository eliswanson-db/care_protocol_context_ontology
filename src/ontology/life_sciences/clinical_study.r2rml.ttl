inition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) o ON o.concept_id = e.object WHERE e.predicate = 'medrt:has_TC' AND s.graph_class = 'Drug' AND o.graph_class = 'DrugClass'" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/Drug/{drug_id}" ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/hasTherapeuticCategory> ;
        rr:objectMap [ rr:template "https://clinical-study-lab.example/ontology/DrugClass/{drug_class_id}" ] ] .

