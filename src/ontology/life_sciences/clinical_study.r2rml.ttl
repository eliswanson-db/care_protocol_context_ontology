# =====================================================================================
# R2RML mappings: Unity Catalog tables -> Clinical Study Ontology (clinical_study.owl.ttl). Hand-maintained, the
# HEDIS pattern (src/ontology/care_protocol.r2rml.ttl): every map reads the real tables directly with an inline
# rr:sqlQuery over eli_test_classic_catalog.clinical_study (SDTM-/ADaM-shaped data) and
# eli_test_classic_catalog.clinical_study_standards (vendored terminologies, classes, rules). No staging views.
#
# Ontobricks source scope: clinical_study + clinical_study_standards. NOT clinical_study_semantic (metric views abort
# the entity scan, HEDIS rev 3/5).
#
# Invariants (HEDIS rev 2, and the first ClinicalStudyLab import):
#   * one IRI prefix per class: https://clinical-study-lab.example/ontology/<Class>/{<class>_id};
#   * one id column per class, <class>_id (e.g. disease_id), reused verbatim by every relationship endpoint,
#     because Ontobricks resolves an endpoint to an entity by column name; a same-class edge (Disease subClassOf
#     Disease) uses <class>_target_id for its target;
#   * every OWL class has an entity map (an unmapped class auto-binds to a leftover table).
# A knowledge-base concept's class comes from kb_concept.scheme / concept_type (MONDO -> Disease, RXNORM -> Drug,
# MEDRT -> DrugClass, MeSH records / concepts, CDISC CT, COSMoS, NCIt / ICD-10-CM -> ReferenceConcept).
# Live check before an import: .venv/bin/python -I scripts/ls_graph_check.py
# 2026-11-23: rewritten onto the real tables (was: one generated view per map in clinical_study_graph).
# =====================================================================================
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix map:  <https://clinical-study-lab.example/ontology/mapping#> .

map:DiseaseEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT ID AS disease_id, Label, code, scheme, release, definition, official_iri FROM (SELECT concept_id AS ID, label AS Label, code, scheme, release, definition, official_iri, notation, class_type, record_type FROM (SELECT concept_id, label, code, scheme, release, definition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) kb WHERE graph_class = 'Disease')" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/Disease/{disease_id}" ; rr:class <https://clinical-study-lab.example/ontology#Disease> ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "Label" ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/code> ; rr:objectMap [ rr:column "code" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/scheme> ; rr:objectMap [ rr:column "scheme" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/release> ; rr:objectMap [ rr:column "release" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/definition> ; rr:objectMap [ rr:column "definition" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/officialIri> ; rr:objectMap [ rr:column "official_iri" ; rr:termType rr:IRI ] ] .

map:DrugEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT ID AS drug_id, Label, code, scheme, release, definition, official_iri FROM (SELECT concept_id AS ID, label AS Label, code, scheme, release, definition, official_iri, notation, class_type, record_type FROM (SELECT concept_id, label, code, scheme, release, definition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) kb WHERE graph_class = 'Drug')" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/Drug/{drug_id}" ; rr:class <https://clinical-study-lab.example/ontology#Drug> ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "Label" ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/code> ; rr:objectMap [ rr:column "code" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/scheme> ; rr:objectMap [ rr:column "scheme" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/release> ; rr:objectMap [ rr:column "release" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/definition> ; rr:objectMap [ rr:column "definition" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/officialIri> ; rr:objectMap [ rr:column "official_iri" ; rr:termType rr:IRI ] ] .

map:DrugClassEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT ID AS drug_class_id, Label, code, scheme, release, definition, official_iri, class_type FROM (SELECT concept_id AS ID, label AS Label, code, scheme, release, definition, official_iri, notation, class_type, record_type FROM (SELECT concept_id, label, code, scheme, release, definition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) kb WHERE graph_class = 'DrugClass')" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/DrugClass/{drug_class_id}" ; rr:class <https://clinical-study-lab.example/ontology#DrugClass> ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "Label" ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/code> ; rr:objectMap [ rr:column "code" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/scheme> ; rr:objectMap [ rr:column "scheme" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/release> ; rr:objectMap [ rr:column "release" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/definition> ; rr:objectMap [ rr:column "definition" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/officialIri> ; rr:objectMap [ rr:column "official_iri" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/classType> ; rr:objectMap [ rr:column "class_type" ; rr:datatype xsd:string ] ] .

map:MeshRecordEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT ID AS mesh_record_id, Label, code, scheme, release, definition, official_iri, record_type FROM (SELECT concept_id AS ID, label AS Label, code, scheme, release, definition, official_iri, notation, class_type, record_type FROM (SELECT concept_id, label, code, scheme, release, definition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) kb WHERE graph_class = 'MeshRecord')" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/MeshRecord/{mesh_record_id}" ; rr:class <https://clinical-study-lab.example/ontology#MeshRecord> ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "Label" ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/code> ; rr:objectMap [ rr:column "code" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/scheme> ; rr:objectMap [ rr:column "scheme" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/release> ; rr:objectMap [ rr:column "release" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/definition> ; rr:objectMap [ rr:column "definition" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/officialIri> ; rr:objectMap [ rr:column "official_iri" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/recordType> ; rr:objectMap [ rr:column "record_type" ; rr:datatype xsd:string ] ] .

map:MeshConceptEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT ID AS mesh_concept_id, Label, code, scheme, release, definition, official_iri FROM (SELECT concept_id AS ID, label AS Label, code, scheme, release, definition, official_iri, notation, class_type, record_type FROM (SELECT concept_id, label, code, scheme, release, definition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) kb WHERE graph_class = 'MeshConcept')" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/MeshConcept/{mesh_concept_id}" ; rr:class <https://clinical-study-lab.example/ontology#MeshConcept> ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "Label" ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/code> ; rr:objectMap [ rr:column "code" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/scheme> ; rr:objectMap [ rr:column "scheme" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/release> ; rr:objectMap [ rr:column "release" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/definition> ; rr:objectMap [ rr:column "definition" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/officialIri> ; rr:objectMap [ rr:column "official_iri" ; rr:termType rr:IRI ] ] .

map:ReferenceConceptEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT ID AS reference_concept_id, Label, code, scheme, release, definition, official_iri FROM (SELECT concept_id AS ID, label AS Label, code, scheme, release, definition, official_iri, notation, class_type, record_type FROM (SELECT concept_id, label, code, scheme, release, definition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) kb WHERE graph_class = 'ReferenceConcept')" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/ReferenceConcept/{reference_concept_id}" ; rr:class <https://clinical-study-lab.example/ontology#ReferenceConcept> ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:column "Label" ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/code> ; rr:objectMap [ rr:column "code" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/scheme> ; rr:objectMap [ rr:column "scheme" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/release> ; rr:objectMap [ rr:column "release" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/definition> ; rr:objectMap [ rr:column "definition" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/officialIri> ; rr:objectMap [ rr:column "official_iri" ; rr:termType rr:IRI ] ] .

map:CodelistEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT ID AS codelist_id, Label, code, scheme, release, definition, official_iri, notation FROM (SELECT concept_id AS ID, label AS Label, code, scheme, release, definition, official_iri, notation, class_type, record_type FROM (SELECT concept_id, label, code, scheme, release, definition, notation, CASE WHEN scheme = 'MONDO' THEN 'Disease' WHEN scheme = 'RXNORM' THEN 'Drug' WHEN scheme = 'MEDRT' THEN 'DrugClass' WHEN scheme = 'MESH' AND split(concept_type, ':')[0] = 'MeshConcept' THEN 'MeshConcept' WHEN scheme = 'MESH' THEN 'MeshRecord' WHEN scheme = 'MESH_SCR' THEN 'MeshRecord' WHEN scheme = 'NCIT' THEN 'ReferenceConcept' WHEN scheme = 'ICD10CM' THEN 'ReferenceConcept' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'Codelist' THEN 'Codelist' WHEN scheme = 'CDISC_CT' AND split(concept_type, ':')[0] = 'CodelistTerm' THEN 'CodelistTerm' WHEN scheme = 'COSMOS_BC' THEN 'BiomedicalConcept' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DatasetSpecialization' THEN 'DatasetSpecialization' WHEN scheme = 'COSMOS_DSS' AND split(concept_type, ':')[0] = 'DSSVariableBinding' THEN 'DSSVariableBinding' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'DatasetVariable' THEN 'DatasetVariable' WHEN scheme = 'SDTM_VAR' AND split(concept_type, ':')[0] = 'Domain' THEN 'SDTMDomain' END AS graph_class, CASE WHEN scheme = 'MONDO' THEN concat('http://purl.obolibrary.org/obo/MONDO_', code) WHEN scheme = 'MESH' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'MESH_SCR' THEN concat('http://id.nlm.nih.gov/mesh/', code) WHEN scheme = 'NCIT' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) WHEN scheme = 'CDISC_CT' THEN CASE WHEN concept_type = 'CodelistTerm' THEN concat('http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#', code) END END AS official_iri, element_at(split(concept_type, ':'), 2) AS class_type, concept_type AS record_type FROM eli_test_classic_catalog.clinical_study_standards.kb_concept) kb WHERE graph_class = 'Codelist')" ] ;
