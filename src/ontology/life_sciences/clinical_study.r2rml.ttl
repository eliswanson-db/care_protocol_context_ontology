# ---- rev 2026-11-25 (ADR-0028): population, deviation and criterion verdicts, mirroring HEDIS ----
map:ProtocolDeviationEntity a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT protocol_deviation_id, deviation_type, severity FROM (SELECT concat(p.USUBJID, '.dev', CAST(x.pos AS STRING)) AS protocol_deviation_id, p.USUBJID AS participant_id, p.eligibility_rule_id AS rule_id, x.d.deviation AS deviation_type, x.d.severity AS severity, x.d.evidence AS evidence FROM eli_test_classic_catalog.clinical_study.gold_participant_population p LATERAL VIEW posexplode(p.deviations) x AS pos, d)" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/ProtocolDeviation/{protocol_deviation_id}" ; rr:class <https://clinical-study-lab.example/ontology#ProtocolDeviation> ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/deviationType> ; rr:objectMap [ rr:column "deviation_type" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/severity> ; rr:objectMap [ rr:column "severity" ; rr:datatype xsd:string ] ] .
map:in_population__participant__analysis_population a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT USUBJID AS participant_id, 'FAS' AS analysis_population_id FROM eli_test_classic_catalog.clinical_study.gold_participant_population WHERE FASFL = 'Y' UNION ALL SELECT USUBJID, 'PPS' FROM eli_test_classic_catalog.clinical_study.gold_participant_population WHERE PPSFL = 'Y'" ] ;
    rr:subjectMap [ rr:template "https://clinical-study-lab.example/ontology/Participant/{participant_id}" ] ;
    rr:predicateObjectMap [ rr:predicate <https://clinical-study-lab.example/ontology/inPopulation> ;
        rr:objectMap [ rr:template "https://clinical-study-lab.example/ontology/AnalysisPopulation/{analysis_population_id}" ] ] .
