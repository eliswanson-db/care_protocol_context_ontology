<https://clinical-study-lab.example/ontology> a owl:Ontology ;
    rdfs:label "Clinical Study Context & Evidence Lab ontology" ;
    rdfs:comment "SYNTHETIC educational demo. Study-design classes are aligned in name with CDISC USDM; knowledge classes mirror MONDO, MED-RT, MeSH, RxNorm, CDISC CT and COSMoS. Relations are named in this namespace (Ontobricks compiles every property as <NS>/<name>); cpl:mirrorsPredicate records the official predicate a relation mirrors and cpl:source where it comes from. Nothing here is official CDISC content." ;
    owl:versionInfo "1.0.0" .

cpl:mirrorsPredicate a owl:AnnotationProperty .
cpl:source a owl:AnnotationProperty .
cpl:usdmAlignment a owl:AnnotationProperty .

