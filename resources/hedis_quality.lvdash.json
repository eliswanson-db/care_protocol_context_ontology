{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline rates",
      "queryLines": [
        "SELECT (SELECT MEASURE(`GSD Compliance Rate`) FROM eli_test_classic_catalog.care_protocol_semantic.gsd_compliance_metrics WHERE `Measurement Year` = 2026) AS gsd_rate, (SELECT MEASURE(`KED Compliance Rate`) FROM eli_test_classic_catalog.care_protocol_semantic.ked_compliance_metrics WHERE `Measurement Year` = 2026) AS ked_rate, (SELECT MEASURE(`BPD Compliance Rate`) FROM eli_test_classic_catalog.care_protocol_semantic.bpd_compliance_metrics WHERE `Measurement Year` = 2026) AS bpd_rate, (SELECT MEASURE(`SPD Compliance Rate`) FROM eli_test_classic_catalog.care_protocol_semantic.spd_compliance_metrics WHERE `Measurement Year` = 2026) AS spd_rate, (SELECT MEASURE(`EED Compliance Rate`) FROM eli_test_classic_catalog.care_protocol_semantic.eed_compliance_metrics WHERE `Measurement Year` = 2026) AS eed_rate"
      ]
    },
    {
      "name": "ds_rates",
      "displayName": "Compliance by measure",
      "queryLines": [
        "SELECT 'GSD' AS measure, MEASURE(`GSD Compliance Rate`) AS rate, MEASURE(`Eligible Patients`) AS eligible FROM eli_test_classic_catalog.care_protocol_semantic.gsd_compliance_metrics WHERE `Measurement Year` = 2026 UNION ALL SELECT 'KED' AS measure, MEASURE(`KED Compliance Rate`) AS rate, MEASURE(`Eligible Patients`) AS eligible FROM eli_test_classic_catalog.care_protocol_semantic.ked_compliance_metrics WHERE `Measurement Year` = 2026 UNION ALL SELECT 'BPD' AS measure, MEASURE(`BPD Compliance Rate`) AS rate, MEASURE(`Eligible Patients`) AS eligible FROM eli_test_classic_catalog.care_protocol_semantic.bpd_compliance_metrics WHERE `Measurement Year` = 2026 UNION ALL SELECT 'SPD' AS measure, MEASURE(`SPD Compliance Rate`) AS rate, MEASURE(`Eligible Patients`) AS eligible FROM eli_test_classic_catalog.care_protocol_semantic.spd_compliance_metrics WHERE `Measurement Year` = 2026 UNION ALL SELECT 'EED' AS measure, MEASURE(`EED Compliance Rate`) AS rate, MEASURE(`Eligible Patients`) AS eligible FROM eli_test_classic_catalog.care_protocol_semantic.eed_compliance_metrics WHERE `Measurement Year` = 2026"
      ]
    },
    {
      "name": "ds_status",
      "displayName": "Status by measure",
      "queryLines": [
        "SELECT 'GSD' AS measure, `Compliance Status` AS status, MEASURE(`Eligible Patients`) AS n FROM eli_test_classic_catalog.care_protocol_semantic.gsd_compliance_metrics WHERE `Measurement Year` = 2026 GROUP BY ALL UNION ALL SELECT 'KED' AS measure, `Compliance Status` AS status, MEASURE(`Eligible Patients`) AS n FROM eli_test_classic_catalog.care_protocol_semantic.ked_compliance_metrics WHERE `Measurement Year` = 2026 GROUP BY ALL UNION ALL SELECT 'BPD' AS measure, `Compliance Status` AS status, MEASURE(`Eligible Patients`) AS n FROM eli_test_classic_catalog.care_protocol_semantic.bpd_compliance_metrics WHERE `Measurement Year` = 2026 GROUP BY ALL UNION ALL SELECT 'SPD' AS measure, `Compliance Status` AS status, MEASURE(`Eligible Patients`) AS n FROM eli_test_classic_catalog.care_protocol_semantic.spd_compliance_metrics WHERE `Measurement Year` = 2026 GROUP BY ALL UNION ALL SELECT 'EED' AS measure, `Compliance Status` AS status, MEASURE(`Eligible Patients`) AS n FROM eli_test_classic_catalog.care_protocol_semantic.eed_compliance_metrics WHERE `Measurement Year` = 2026 GROUP BY ALL"
      ]
    },
    {
      "name": "ds_gap_summary",
      "displayName": "Care gaps by reason",
      "queryLines": [
        "SELECT measure, gap_reason, patients FROM (SELECT 'GSD' AS measure, `Gap Reason` AS gap_reason, MEASURE(`Eligible Patients`) AS patients FROM eli_test_classic_catalog.care_protocol_semantic.gsd_compliance_metrics WHERE `Measurement Year` = 2026 AND `Compliance Status` = 'NOT_MET' GROUP BY ALL UNION ALL SELECT 'KED' AS measure, `Gap Reason` AS gap_reason, MEASURE(`Eligible Patients`) AS patients FROM eli_test_classic_catalog.care_protocol_semantic.ked_compliance_metrics WHERE `Measurement Year` = 2026 AND `Compliance Status` = 'NOT_MET' GROUP BY ALL UNION ALL SELECT 'BPD' AS measure, `Gap Reason` AS gap_reason, MEASURE(`Eligible Patients`) AS patients FROM eli_test_classic_catalog.care_protocol_semantic.bpd_compliance_metrics WHERE `Measurement Year` = 2026 AND `Compliance Status` = 'NOT_MET' GROUP BY ALL UNION ALL SELECT 'SPD' AS measure, `Gap Reason` AS gap_reason, MEASURE(`Eligible Patients`) AS patients FROM eli_test_classic_catalog.care_protocol_semantic.spd_compliance_metrics WHERE `Measurement Year` = 2026 AND `Compliance Status` = 'NOT_MET' GROUP BY ALL UNION ALL SELECT 'EED' AS measure, `Gap Reason` AS gap_reason, MEASURE(`Eligible Patients`) AS patients FROM eli_test_classic_catalog.care_protocol_semantic.eed_compliance_metrics WHERE `Measurement Year` = 2026 AND `Compliance Status` = 'NOT_MET' GROUP BY ALL) ORDER BY patients DESC"
      ]
    },
    {
      "name": "ds_gaps",
      "displayName": "Care gap worklist (patient-level)",
      "queryLines": [
        "SELECT 'GSD' AS measure, patient_id, age, CASE WHEN evidence_value <= 9.0 THEN 'Met' WHEN evidence_datetime IS NULL THEN 'No A1c test in measurement year' ELSE 'Last A1c above 9%' END AS gap_reason FROM eli_test_classic_catalog.care_protocol.gold_adherence_gsd WHERE measurement_year = 2026 AND CASE WHEN evidence_value <= 9.0 THEN 'MET' ELSE 'NOT_MET' END = 'NOT_MET' UNION ALL SELECT 'KED' AS measure, patient_id, age, CASE WHEN egfr_datetime IS NOT NULL AND uacr_datetime IS NOT NULL THEN 'Met' WHEN egfr_datetime IS NULL AND uacr_datetime IS NULL THEN 'No eGFR or uACR test' WHEN egfr_datetime IS NULL THEN 'No eGFR test' ELSE 'No uACR test' END AS gap_reason FROM eli_test_classic_catalog.care_protocol.gold_adherence_ked WHERE measurement_year = 2026 AND CASE WHEN egfr_datetime IS NOT NULL AND uacr_datetime IS NOT NULL THEN 'MET' ELSE 'NOT_MET' END = 'NOT_MET' UNION ALL SELECT 'BPD' AS measure, patient_id, age, CASE WHEN systolic < 140 AND diastolic < 90 THEN 'Met' WHEN bp_datetime IS NULL THEN 'No BP reading in measurement year' ELSE 'BP not controlled (>=140/90)' END AS gap_reason FROM eli_test_classic_catalog.care_protocol.gold_adherence_bpd WHERE measurement_year = 2026 AND CASE WHEN systolic < 140 AND diastolic < 90 THEN 'MET' ELSE 'NOT_MET' END = 'NOT_MET' UNION ALL SELECT 'SPD' AS measure, patient_id, age, CASE WHEN evidence_datetime IS NOT NULL THEN 'Met' ELSE 'No statin dispensed in measurement year' END AS gap_reason FROM eli_test_classic_catalog.care_protocol.gold_adherence_spd WHERE measurement_year = 2026 AND CASE WHEN evidence_datetime IS NOT NULL THEN 'MET' ELSE 'NOT_MET' END = 'NOT_MET' UNION ALL SELECT 'EED' AS measure, patient_id, age, CASE WHEN evidence_datetime IS NOT NULL THEN 'Met' ELSE 'No diabetic eye exam in measurement year' END AS gap_reason FROM eli_test_classic_catalog.care_protocol.gold_adherence_eed WHERE measurement_year = 2026 AND CASE WHEN evidence_datetime IS NOT NULL THEN 'MET' ELSE 'NOT_MET' END = 'NOT_MET' ORDER BY measure, age DESC"
      ]
    }
  ],
